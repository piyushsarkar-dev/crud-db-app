    {
      "id": "Pm6II8FgiS2fxkdJ1bWgz",
      "type": "text",
      "x": -1649.596515979404,
      "y": 1981.4478262245834,
      "width": 605.339111328125,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
